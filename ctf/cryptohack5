                    <code class=" coming-soon-regular">
def scalar_multiplication(P, n, a, mod):
    Q = P
    R = O
    while n > 0:
        if n % 2 == 1:
            R = add_points(R,Q, a, mod)
        Q = add_points(Q, Q, a, mod)
        n = n // 2
    return R

