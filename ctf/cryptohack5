O = (0, 0)
def add_points(P, Q, a, mod):
    if P == O:
        return Q
    if Q == O:
        return P
    
    if P[0] == Q[0] and (P[1] + Q[1]) % mod == 0:
        return O

    if P != Q:
        y2_y1 = (Q[1] - P[1]) % mod
        x2_x1 = (Q[0] - P[0]) % mod
        lam = (y2_y1 * pow(x2_x1, -1, mod)) % mod
    else:
        if P[1] % mod == 0:
            return O
        num = (3 * P[0] * P[0] + a) % mod    
        den = pow((2 * P[1]) % mod, -1, mod)  
        lam = (num * den) % mod

    x3 = (lam * lam - P[0] - Q[0]) % mod
    y3 = (lam * (P[0] - x3) - P[1]) % mod
    return (x3, y3)


