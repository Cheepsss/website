                    <p class="notebook-p coming-soon-regular dotted" style="background-color: rgba(151, 240, 42, 0.13);">
                    <strong class="underline highlight-green">Legendre symbol</strong><br>
                    <strong>(a / p) = 0</strong> if a ≡ 0 mod p<br>
                    <strong>(a / p) = 1</strong> if a is a quadratic residue mod p<br>
                    <strong>(a / p) = -1</strong> if a is a non-quadratic residue mod p<br><br>
                    <strong class="underline highlight-green">Euler criterion</strong><br>
                    For an odd prime p and an integer a not divisible by p:<br>
                    <strong>(a / p) ≡ a<sup>(p - 1) / 2</sup> mod p</strong>
                    </p>
                    <p class="notebook-p coming-soon-regular">
                        <br>
                        Explicatie:<br>
                        Cand bitul este 1, se adauga n la cifru<br>
                        Cand bitul este 0, sa adauga -n la cifru<br>
                        <br>
                        Pentru ca a este quadratic residue, a<sup>e</sup>= n este mereu quadratic residue<br>
                        -n nu este quadratic residue si putem verifica folosind criteriul lui Euler

                    </p>
                    <code class="notebook-p coming-soon-regular dotted">
def decrypt(ciphertext, p):
    bits = []
    for c in ciphertext:
        legendre = pow(c, (p - 1) // 2, p)
        if legendre == 1:
            bits.append('1')
        else:
            bits.append('0')

    b_list = [bits[i:i+8] for i in range(0, len(bits), 8)]
    
    f_bytes = bytearray()
    for b_bits in b_list:
        b_str = ''.join(b_bits)
        f_bytes.append(int(b_str, 2))
    
    return f_bytes.decode()
