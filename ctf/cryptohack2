Enter whichever of u and v is the lower number as the flag.</p>
                    <code class="notebook-p coming-soon-regular dotted">
def gcdExtended(a, b): 
    if a == 0 : 
        return b,0,1
            
    gcd,x1,y1 = gcdExtended(b%a, a) 
    x = y1 - (b//a) * x1 
    y = x1     
    return gcd,x,y 

print(gcdExtended(26513,32321))
